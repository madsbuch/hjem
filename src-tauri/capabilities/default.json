{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Basic window functionality for the local Hjem interface.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "launcher:default",
    "allow-qr-scanner-native",
    "allow-home-scene-config",
    "allow-concierge-get-settings",
    "allow-concierge-save-settings",
    "allow-concierge-clear-key",
    "allow-concierge-test-key",
    "allow-concierge-list-models",
    "allow-concierge-request",
    "allow-concierge-voice-request",
    "allow-concierge-cancel",
    "allow-storage-load",
    "allow-storage-save-connection",
    "allow-storage-clear-connection",
    "allow-storage-set-theme",
    "allow-storage-set-pinned-apps",
    "allow-storage-set-app-hidden",
    "allow-storage-set-favourites",
    "allow-storage-set-selected-speaker",
    "allow-storage-import-legacy",
    "allow-calendar-add-feed",
    "allow-calendar-update-feed",
    "allow-calendar-remove-feed",
    "allow-calendar-fetch-feed"
  ]
}
