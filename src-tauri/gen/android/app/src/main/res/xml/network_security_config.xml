<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Local app origin and Home Assistant's standard local hostname only.
         Add your exact LAN hostname/IP here if it does not support HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">tauri.localhost</domain>
        <domain includeSubdomains="false">homeassistant.local</domain>
    </domain-config>
</network-security-config>
