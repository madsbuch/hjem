<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Home Assistant addresses are supplied by the user and may be arbitrary
         LAN IPs or local hostnames using HTTP/WebSocket. Android's static domain
         rules cannot express user-configured destinations or private-IP ranges.
         Keep TLS certificate validation at the platform default; this enables
         cleartext connections without changing HTTPS trust anchors. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
