{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hjem",
  "version": "0.1.0",
  "identifier": "dk.madsbuch.hjem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1435",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Hjem",
      "useHttpsScheme": false,
      "width": 1200,
      "height": 850,
      "minWidth": 360,
      "minHeight": 600,
      "backgroundColor": "#F6F3E9"
    }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss:",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "Your home, a little closer.",
    "longDescription": "A calm, touch-friendly interface for your Home Assistant home, on phone, tablet and desktop.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
